{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>edbfi/automation//default.json#v1.1.3",
    "github>edbfi/automation//automerge.json#v1.1.3"
  ],
  "packageRules": [
    {
      "description": "Keep the minimum compatibility lane on Go 1.26 patches; the current lane can advance to newer release lines.",
      "matchFileNames": [
        ".github/workflows/push.yaml"
      ],
      "matchDatasources": [
        "golang-version"
      ],
      "matchCurrentVersion": "/^1\\.26\\./",
      "allowedVersions": ">=1.26.0 <1.27.0"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/push\\.yaml$/"
      ],
      "matchStrings": [
        "go: (?<currentValue>1\\.\\d+\\.\\d+)\\n"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go"
    }
  ],
  "forkProcessing": "enabled"
}
